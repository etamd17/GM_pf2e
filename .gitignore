__pycache__/
*.pyc
.DS_Store
*.db-journal
venv/
.venv/
.env

# Agent worktrees — git linked-worktree checkouts under .claude/ are local
# scratch; never commit their checkouts or pointer files.
# (.claude/launch.json is tracked and intentionally kept.)
.claude/worktrees/

# Local-only Pathbuilder PC exports — used for verifying class progressions
# and calculation fixes. PCs reach the live site through the in-app
# JSON-upload + character-creator flow, NOT via the repo.
party_data/*.json
!party_data/portraits/

# GM-authored campaign intro metadata — local content, not repo state.
campaign.json

# Obsidian vault sync state — populated on the server's persistent
# volume by tools/push_vault.py; never committed.
vault_data/
.vault_last_push_ts
.vault_local_last_push_ts
obsidian_vault

# GM-uploaded campaign assets (splash images etc.) — server-local,
# never committed; lives on the Railway volume.
campaign_assets/

# Campaign audio — a symlink to the GM's local Foundry/audio folder (or a
# PF2E_AUDIO_DIR). Machine-specific, never committed.
campaign_audio

# Session-complete scrapbook data (Chunk 6) — runtime state on the volume
# (DATA_DIR): the in-flight highlights accumulator + saved per-session
# scrapbooks. Never committed.
session_highlights.json
scrapbooks/

# Per-campaign runtime state. In account/campaign mode these live under
# DATA_DIR/campaigns/<id>/; in the legacy flat layout the app writes them to
# the DATA_DIR root (locally, the repo root). Runtime state, never committed.
campaign_stats.json
loot_ledger.json
pinned_generators.json
calendar.json
journals/
uploads/

# Live server state the app REWRITES at runtime. These were tracked, which is
# actively harmful in three ways:
#   1. The app deletes and rewrites them. _do_persist_encounter_state removes
#      _autosave.json whenever no encounter is active, so merely running the
#      app against the repo shows a tracked file as deleted.
#   2. The committed copies are stale and wrong. server_state.json has NO
#      live_campaign_id, so if DATA_DIR ever resolves to the checkout a deploy
#      points the app at no campaign at all; _autosave.json holds a captured
#      fight ("Kyle", 8 HP) that would rehydrate over a real one.
#   3. DEPLOY.md's routine update is `git add -A`, which sweeps whatever the
#      current session happened to write into a commit.
# They stay on disk; git just stops tracking them.
server_state.json
saved_encounters/
story_threads.json

# Built Cosmere player characters — runtime store on the volume (DATA_DIR),
# kept out of the PF2e party_data. Never committed.
cosmere_pcs/

# Per-campaign Cosmere homebrew shelf — runtime store on the volume (DATA_DIR).
homebrew.json

# Per-player session-notes scratchpads — runtime state on the volume.
session_notes/

# Tactical scenes: scene JSON, the active-scene index, and GM-uploaded map
# backgrounds. In campaign mode these live under DATA_DIR/campaigns/<id>/scenes/;
# in the legacy flat layout core.storage.scenes_dir(None) writes them to the
# DATA_DIR root (locally, the repo root). Runtime state + uploaded art, never
# committed.
scenes/

# Published Chronicle content + GM-uploaded Chronicle documents. Campaign mode
# puts these under DATA_DIR/campaigns/<id>/chronicle/; the legacy flat layout
# writes them to the DATA_DIR root (locally, the repo root). Leading slash so
# this anchors to the repo root ONLY -- an unanchored `chronicle/` would also
# swallow docs/chronicle/, which is tracked documentation.
/chronicle/

# Persisted Flask session secret (stable across restarts; never commit)
.secret_key

# Brainstorming visual-companion session artifacts
.superpowers/
