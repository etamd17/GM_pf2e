{
  "name": "gm-pf2e-vtt-client",
  "private": true,
  "type": "module",
  "description": "PF2e VTT web client (React + raw PixiJS). Owned by the client lead; see docs/vtt/.",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:bundle": "node scripts/check-bundle.mjs",
    "generate:protocol": "node scripts/generate-protocol.mjs",
    "check:protocol": "node scripts/generate-protocol.mjs --check"
  },
  "dependencies": {
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@tanstack/react-query": "5.104.2",
    "pixi.js": "8.22.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io-client": "4.8.1",
    "socket.io-parser": "4.2.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "28.0.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "ajv": "8.20.0",
    "jsdom": "29.1.1",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
