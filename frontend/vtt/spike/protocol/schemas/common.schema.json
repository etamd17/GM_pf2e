{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vtt.invalid/v1/common.schema.json",
  "title": "Common",
  "definitions": {
    "SchemaVersion": { "title": "SchemaVersion", "const": 1 },
    "Id": { "title": "Id", "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]+$" },
    "OpaqueToken": { "title": "OpaqueToken", "type": "string", "minLength": 16, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$" },
    "Seq": { "title": "Seq", "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "Coord": { "title": "Coord", "type": "number", "minimum": -100000, "maximum": 100000 }
  }
}
