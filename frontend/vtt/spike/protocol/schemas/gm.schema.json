{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vtt.invalid/v1/gm.schema.json",
  "title": "GmFrame",
  "oneOf": [{ "$ref": "#/definitions/GmPatch" }],
  "definitions": {
    "GmToken": {
      "title": "GmToken",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version", "x", "y", "label", "hidden", "hp"],
      "properties": {
        "kind": { "const": "token" },
        "id": { "$ref": "common.schema.json#/definitions/Id" },
        "version": { "$ref": "common.schema.json#/definitions/OpaqueToken" },
        "x": { "$ref": "common.schema.json#/definitions/Coord" },
        "y": { "$ref": "common.schema.json#/definitions/Coord" },
        "label": { "type": "string", "maxLength": 80 },
        "hidden": { "type": "boolean" },
        "hp": { "type": "integer", "minimum": -9999, "maximum": 99999 }
      }
    },
    "GmPatch": {
      "title": "GmPatch",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "frame", "subscriptionId", "seq", "upserted", "removed"],
      "properties": {
        "schemaVersion": { "$ref": "common.schema.json#/definitions/SchemaVersion" },
        "frame": { "const": "patch" },
        "subscriptionId": { "$ref": "common.schema.json#/definitions/OpaqueToken" },
        "seq": { "$ref": "common.schema.json#/definitions/Seq" },
        "originCommandId": { "$ref": "common.schema.json#/definitions/OpaqueToken" },
        "upserted": { "type": "array", "maxItems": 2000, "items": { "$ref": "#/definitions/GmToken" } },
        "removed": { "type": "array", "maxItems": 2000, "items": { "$ref": "table.schema.json#/definitions/EntityRef" } }
      }
    }
  }
}
