# VTT contracts and generated protocol sources keep LF (schema amendment S3)
contracts/vtt/** text eol=lf
frontend/vtt/src/protocol/generated/** text eol=lf

# Files that run inside Linux containers keep LF on every checkout (M6): a CRLF
# shebang or Caddyfile breaks the image built from a Windows working tree.
docker/** text eol=lf
Dockerfile text eol=lf
compose.yaml text eol=lf
.dockerignore text eol=lf

# From main.
systems/pf2e/rules/evidence/** text eol=lf
compendium_data/classes/*.json text eol=lf
systems/pf2e/rules/reviews/**/*.json text eol=lf

# Scripts run by sh inside the container (P-1) keep LF too.
tools/vtt/*.sh text eol=lf
