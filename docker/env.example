# Copy to .env at the repository root (.env is gitignored) and replace every
# value. Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
VTT_SECRET_KEY=replace-me
VTT_DB_PASSWORD=replace-me
VTT_ASSETS_KEY=vtt-assets
VTT_ASSETS_SECRET=replace-me

# Only for `docker compose --profile lan up`: the name the TV opens, which must
# resolve to this machine on the LAN, and the origin it presents.
# VTT_LAN_HOST=vtt.lan
# VTT_ALLOWED_ORIGINS=https://vtt.lan
