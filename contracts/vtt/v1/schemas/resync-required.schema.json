{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vtt.invalid/v1/resync-required.schema.json",
  "title": "ResyncRequired",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "subscriptionId",
    "reason"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/definitions/SchemaVersion"
    },
    "subscriptionId": {
      "$ref": "common.schema.json#/definitions/OpaqueToken",
      "description": "The subscription this resync ends. A client ignores a resync that names neither its live nor its pending subscription."
    },
    "reason": {
      "$ref": "common.schema.json#/definitions/ResyncReason"
    }
  }
}
