{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vtt.invalid/v1/gm-subscribe.schema.json",
  "title": "GmSubscribe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "audience",
    "campaignId",
    "sceneId"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "common.schema.json#/definitions/SchemaVersion"
    },
    "audience": {
      "const": "gm"
    },
    "campaignId": {
      "$ref": "common.schema.json#/definitions/Id"
    },
    "sceneId": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/definitions/Id"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
