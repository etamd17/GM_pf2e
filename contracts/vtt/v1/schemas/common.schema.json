{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vtt.invalid/v1/common.schema.json",
  "title": "Common",
  "definitions": {
    "SchemaVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "const": 1
    },
    "Id": {
      "title": "Id",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
    },
    "OpaqueToken": {
      "title": "OpaqueToken",
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])"
    },
    "Seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "Coord": {
      "type": "number",
      "minimum": 0,
      "maximum": 16384
    },
    "Color": {
      "type": "integer",
      "minimum": 0,
      "maximum": 16777215
    },
    "Label": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069\\ud800-\\udfff]*(?![\\s\\S])",
      "description": "Display text. Excludes C0/C1 controls, bidi overrides/isolates and unpaired surrogates; length counts code points."
    },
    "CampaignRole": {
      "type": "string",
      "enum": [
        "gm",
        "assistant",
        "player",
        "observer"
      ]
    },
    "Capability": {
      "type": "string",
      "enum": [
        "scene.prepare",
        "scene.publish",
        "token.control",
        "token.move",
        "campaign.manage"
      ]
    },
    "ResyncReason": {
      "type": "string",
      "enum": [
        "scene-changed",
        "reconnected",
        "sequence-gap",
        "buffer-overflow",
        "state-lost",
        "grant-changed",
        "revoked",
        "version-changed"
      ]
    },
    "BootstrapRejectionReason": {
      "type": "string",
      "enum": [
        "grant-revoked",
        "grant-expired",
        "session-ended",
        "unsupported-version"
      ]
    },
    "RejectionCode": {
      "type": "string",
      "enum": [
        "invalid-schema",
        "unsupported-version",
        "unknown-command",
        "authentication-required",
        "unauthorized",
        "rate-limited",
        "command-id-reused",
        "stale",
        "conflict",
        "validation-failed",
        "rule-violation",
        "recipient-offline",
        "resync-required",
        "temporarily-unavailable",
        "server-error"
      ]
    },
    "TableScene": {
      "title": "TableScene",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "name",
        "width",
        "height",
        "gridSize",
        "showGrid",
        "backgroundAssetId"
      ],
      "properties": {
        "kind": {
          "const": "scene"
        },
        "id": {
          "$ref": "common.schema.json#/definitions/Id"
        },
        "version": {
          "$ref": "common.schema.json#/definitions/OpaqueToken"
        },
        "name": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u202a-\\u202e\\u2066-\\u2069\\ud800-\\udfff]*(?![\\s\\S])"
        },
        "width": {
          "type": "number",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "number",
          "minimum": 1,
          "maximum": 16384
        },
        "gridSize": {
          "type": "number",
          "minimum": 8,
          "maximum": 1024
        },
        "showGrid": {
          "type": "boolean"
        },
        "backgroundAssetId": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TableToken": {
      "title": "TableToken",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "x",
        "y",
        "size",
        "label",
        "color",
        "artAssetId",
        "actorId"
      ],
      "properties": {
        "kind": {
          "const": "token"
        },
        "id": {
          "$ref": "common.schema.json#/definitions/Id"
        },
        "version": {
          "$ref": "common.schema.json#/definitions/OpaqueToken"
        },
        "x": {
          "$ref": "common.schema.json#/definitions/Coord",
          "description": "Token centre, in scene pixels."
        },
        "y": {
          "$ref": "common.schema.json#/definitions/Coord",
          "description": "Token centre, in scene pixels."
        },
        "size": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 10
        },
        "label": {
          "$ref": "common.schema.json#/definitions/Label"
        },
        "color": {
          "$ref": "common.schema.json#/definitions/Color"
        },
        "artAssetId": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "actorId": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "live": {
          "description": "Tracker state of the linked actor (parity-3); null when unlinked or the actor is absent. Always sent by the server.",
          "anyOf": [
            {
              "$ref": "common.schema.json#/definitions/TableLive"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TableLight": {
      "title": "TableLight",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "x",
        "y",
        "radius",
        "color"
      ],
      "properties": {
        "kind": {
          "const": "light"
        },
        "id": {
          "$ref": "common.schema.json#/definitions/Id"
        },
        "version": {
          "$ref": "common.schema.json#/definitions/OpaqueToken"
        },
        "x": {
          "$ref": "common.schema.json#/definitions/Coord"
        },
        "y": {
          "$ref": "common.schema.json#/definitions/Coord"
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 16384
        },
        "color": {
          "$ref": "common.schema.json#/definitions/Color"
        }
      }
    },
    "FogState": {
      "title": "FogState",
      "description": "One per scene (id \"fog\"), parity-1. revealed is a base64url bitset, row-major, least significant bit first, of exactly ceil(cols*rows/8) bytes with zero padding bits (a semantic rule). cols*rows is at most 262144.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "enabled",
        "cols",
        "rows",
        "revealed"
      ],
      "properties": {
        "kind": {
          "const": "fog"
        },
        "id": {
          "const": "fog"
        },
        "version": {
          "$ref": "common.schema.json#/definitions/OpaqueToken"
        },
        "enabled": {
          "type": "boolean"
        },
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "revealed": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "maxLength": 43691
        }
      }
    },
    "TableTemplate": {
      "title": "TableTemplate",
      "description": "An area template (parity-2) as the table sees it: never hidden ones, never one anchored under fog.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "shape",
        "x",
        "y",
        "aimX",
        "aimY",
        "size",
        "color"
      ],
      "properties": {
        "kind": {
          "const": "template"
        },
        "id": {
          "$ref": "common.schema.json#/definitions/Id"
        },
        "version": {
          "$ref": "common.schema.json#/definitions/OpaqueToken"
        },
        "shape": {
          "type": "string",
          "enum": [
            "burst",
            "emanation",
            "cone",
            "line"
          ]
        },
        "x": {
          "$ref": "common.schema.json#/definitions/Coord"
        },
        "y": {
          "$ref": "common.schema.json#/definitions/Coord"
        },
        "aimX": {
          "$ref": "common.schema.json#/definitions/Coord"
        },
        "aimY": {
          "$ref": "common.schema.json#/definitions/Coord"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "color": {
          "$ref": "common.schema.json#/definitions/Color"
        }
      }
    },
    "TerrainState": {
      "title": "TerrainState",
      "description": "One per scene (id \"terrain\"), parity-2. cells is a base64url run of 4-bit kinds, two cells per byte, low nibble first, exactly ceil(cols*rows/2) bytes; 0 none, 1 lava, 2 water, 3 poison, 4 blood; 5-15 reserved (a semantic rule). cols*rows is at most 262144.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "cols",
        "rows",
        "cells"
      ],
      "properties": {
        "kind": {
          "const": "terrain"
        },
        "id": {
          "const": "terrain"
        },
        "version": {
          "$ref": "common.schema.json#/definitions/OpaqueToken"
        },
        "cols": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        },
        "cells": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "maxLength": 174763
        }
      }
    },
    "LiveCondition": {
      "title": "LiveCondition",
      "description": "A tracker condition (parity-3): its vocabulary name (ASCII letters, digits, space, underscore, apostrophe, hyphen), and its value when it has one (Frightened 2); null for a plain flag.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 _'-]{0,39}(?![\\s\\S])"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 99
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "LiveConditions": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "$ref": "common.schema.json#/definitions/LiveCondition"
      }
    },
    "TableLive": {
      "title": "TableLive",
      "description": "What the table may know of a linked token's tracker state (parity-3). Exact hp/maxHp for a player character, otherwise null; a non-PC has only status (Wounded at or below half, Dead at 0, null above half). active marks the creature whose turn it is.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hp",
        "maxHp",
        "status",
        "conditions",
        "active"
      ],
      "properties": {
        "hp": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9999,
              "maximum": 99999
            },
            {
              "type": "null"
            }
          ]
        },
        "maxHp": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 99999
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "Wounded",
                "Dead"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "conditions": {
          "$ref": "common.schema.json#/definitions/LiveConditions"
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    "TransientPoint": {
      "title": "TransientPoint",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "$ref": "common.schema.json#/definitions/Coord"
        },
        "y": {
          "$ref": "common.schema.json#/definitions/Coord"
        }
      }
    },
    "Transient": {
      "title": "Transient",
      "description": "A transient (beta-1, ADR-0002 section 9): never stored, replayed or acknowledged. ping marks a point; ruler is a measured path of 2-8 points; ruler-clear ends the sender's ruler.",
      "oneOf": [
        {
          "title": "TransientPing",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "x",
            "y"
          ],
          "properties": {
            "type": {
              "const": "ping"
            },
            "x": {
              "$ref": "common.schema.json#/definitions/Coord"
            },
            "y": {
              "$ref": "common.schema.json#/definitions/Coord"
            }
          }
        },
        {
          "title": "TransientRuler",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "points",
            "rule"
          ],
          "properties": {
            "type": {
              "const": "ruler"
            },
            "points": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "$ref": "common.schema.json#/definitions/TransientPoint"
              }
            },
            "rule": {
              "type": "string",
              "enum": [
                "uniform",
                "alternating"
              ],
              "description": "How the distance is counted, chosen by the sender from the campaign's system: uniform (every square 5 ft, diagonals included: Cosmere, D&D 5e) or alternating (diagonals alternate 5 and 10 ft: PF2e)."
            }
          }
        },
        {
          "title": "TransientRulerClear",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "ruler-clear"
            }
          }
        }
      ]
    }
  }
}
